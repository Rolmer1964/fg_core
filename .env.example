# ============================================================
# fg_core — variáveis de ambiente (prefixo FG_CORE_)
# Nenhuma é obrigatória; abaixo estão os defaults.
# ============================================================

# ---- fg_rag (chunk + embedding + índice FAISS) ----
FG_CORE_RAG_DIRETORIO_DOCUMENTOS=documentos
FG_CORE_RAG_DIRETORIO_INDICE=indice
FG_CORE_RAG_TAMANHO_TRECHO=1000
FG_CORE_RAG_SOBREPOSICAO_TRECHO=200
# "titan" (AWS Bedrock) | "deterministico" (offline, para dev/testes sem AWS)
FG_CORE_RAG_VETORIZADOR=titan
FG_CORE_RAG_DIMENSAO_EMBEDDING=1024
FG_CORE_RAG_MODELO_EMBEDDING_BEDROCK=amazon.titan-embed-text-v2:0
FG_CORE_RAG_TOP_K=4
FG_CORE_RAG_REGIAO_AWS=us-east-1
