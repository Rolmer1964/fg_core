# ============================================================
# fg_core — variáveis de ambiente (prefixo FG_CORE_)
# Nenhuma é obrigatória; abaixo estão os defaults.
# ============================================================

# ---- fg_rag (chunk + embedding + índice FAISS) ----
FG_CORE_RAG_DIRETORIO_DOCUMENTOS=documentos
FG_CORE_RAG_DIRETORIO_INDICE=indice
FG_CORE_RAG_TAMANHO_TRECHO=1000
FG_CORE_RAG_SOBREPOSICAO_TRECHO=200
# "titan" (AWS Bedrock) | "deterministico" (offline, para dev/testes sem AWS)
FG_CORE_RAG_VETORIZADOR=titan
FG_CORE_RAG_DIMENSAO_EMBEDDING=1024
FG_CORE_RAG_MODELO_EMBEDDING_BEDROCK=amazon.titan-embed-text-v2:0
FG_CORE_RAG_TOP_K=4
FG_CORE_RAG_REGIAO_AWS=us-east-1

# ---- fg_guardrail (guardrails de entrada e saída) ----
# Sem os IDs, roda só a camada local (heurística + regex), sem AWS.
FG_CORE_GUARDRAIL_ID=
FG_CORE_GUARDRAIL_VERSAO=DRAFT
FG_CORE_GUARDRAIL_ID_SAIDA=
FG_CORE_GUARDRAIL_VERSAO_SAIDA=DRAFT
FG_CORE_GUARDRAIL_REGIAO_AWS=us-east-1
FG_CORE_GUARDRAIL_TAMANHO_MINIMO_ENTRADA=10

# ---- fg_triagem (classificação — Claude Haiku via Bedrock) ----
FG_CORE_TRIAGEM_MODELO_BEDROCK=us.anthropic.claude-haiku-4-5-20251001-v1:0
FG_CORE_TRIAGEM_REGIAO_AWS=us-east-1
FG_CORE_TRIAGEM_TEMPERATURA=0.1
FG_CORE_TRIAGEM_MAX_TOKENS=600

# ---- fg_risco (avaliação de risco — Claude Sonnet via Bedrock) ----
FG_CORE_RISCO_MODELO_BEDROCK=us.anthropic.claude-sonnet-4-5-20250929-v1:0
FG_CORE_RISCO_REGIAO_AWS=us-east-1
FG_CORE_RISCO_TEMPERATURA=0.2
FG_CORE_RISCO_MAX_TOKENS=800

# ---- fg_relatorios (consolidação POL-SAC-001 + saídas JSON/CSV/MD) ----
FG_CORE_RELATORIOS_OUTPUT_DIR=output
